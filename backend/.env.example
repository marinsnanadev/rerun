# Copy to .env for local development. Every variable is optional.

# SQLAlchemy URL. SQLite is the default; use a postgresql+psycopg:// URL in production.
RERUN_DATABASE_URL=sqlite:///./rerun.db

# Name of the HTTP-only cookie that carries the session.
RERUN_SESSION_COOKIE_NAME=rerun_session

# How long a sign-in lasts, in days.
RERUN_SESSION_TTL_DAYS=30

# Send the session cookie over HTTPS only. Set to true in production.
RERUN_COOKIE_SECURE=false
